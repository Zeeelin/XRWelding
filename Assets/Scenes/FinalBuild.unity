  M1Screen: {fileID: 21300000, guid: f7af0acb6437f004a8024c57931c01f0, type: 3}
  FreeBuildScreen: {fileID: 21300000, guid: d500e36b95d2d3945a30b7873066e513, type: 3}
  hasPickUpMask: 0
