  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FuelContainerPickUp
  grabbable: {fileID: 1544911930}
  isWeldDone: 0
  inAreaToSubmit: 0
  evaluationList:
  - {fileID: 2005505250}
  - {fileID: 99090258}
  - {fileID: 234497264}
  hasPickUp: 0
  glowMat: {fileID: 2100000, guid: 4125c2dfbd6a35b4f867b8fbe484df95, type: 2}
  isOneWelded: 0
  isTwoWelded: 0
  isThreeWelded: 0
  subtitles:
  - sentences:
    - text: That is a start, there are still more cracks to be filled.
      displayTime: 4
    displayMode: 0
    typingSpeed: 0
    targetTextWindow: {fileID: 1406757753}
  - sentences:
    - text: Almost there, captain, do not flag now.
      displayTime: 0
    displayMode: 0
    typingSpeed: 3
    targetTextWindow: {fileID: 1406757753}
  - sentences:
    - text: My scans show no more cracks. Please return the fuel cell to its casing
        immediately.
      displayTime: 6
    displayMode: 0
    typingSpeed: 0
    targetTextWindow: {fileID: 1406757753}
  - sentences:
    - text: ' Proceed with extreme caution captain, the fuel cell is in critical
        condition. '
      displayTime: 4
    - text: Even though you are completely out of your depth, do not panic.
      displayTime: 4
    - text: 'Use your welding torch to fill in the cracks in the cell. Be sure to
        examine all sides. '
      displayTime: 7
    - text: "But I would highly recommend completing this repair as\u2026 efficiently
        as possible. "
      displayTime: 6
    displayMode: 0
    typingSpeed: 0
    targetTextWindow: {fileID: 1406757753}
