  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroGameManager
  state: 1
  TVScreen: {fileID: 1605855987}
  M1Screen: {fileID: 21300000, guid: 1578807e902ad304aab5fa6c2f0e4081, type: 3}
  FreeBuildScreen: {fileID: 21300000, guid: 496f227b4832431489bf53765c10072c, type: 3}
  hasPickUpMask: 0
  weldMask: {fileID: 1981861012}
  inMainRoom: 0
  ChangedLight:
  - {fileID: 314025453}
  - {fileID: 1347952560}
  - {fileID: 772757444}
  BrokenFuelCellVisual: {fileID: 110288107}
  FuelCellWeldable: {fileID: 1544911927}
  mainCOunterAnimation: {fileID: 1155228216}
  IsFuelCellAvailable: 0
  endCollider: {fileID: 565666410}
  subtitles:
  - sentences:
    - text: Captain, there is an asteroid on a collision course with The Picasso.
      displayTime: 3.5
    - text: 'Prepare for impact. '
      displayTime: 2.5
    displayMode: 0
    typingSpeed: 0.05
    targetTextWindow: {fileID: 1406757753}
  - sentences:
    - text: ' Alert! Alert! Hull breach detected. '
      displayTime: 5
    - text: "Quarantining breach zone\u2026  "
      displayTime: 2
    displayMode: 0
    typingSpeed: 0.05
    targetTextWindow: {fileID: 1406757753}
  - sentences:
    - text: 'Warning! Insufficient material. '
      displayTime: 3
    - text: ' Captain, please send more material from maintenance so I may complete
        the repair. '
      displayTime: 5
    displayMode: 0
    typingSpeed: 0.05
    targetTextWindow: {fileID: 1406757753}
  - sentences:
    - text: 'Fuel cell restored, well done Captain. '
      displayTime: 3
    - text: 'Scans show internal systems are now stable and main power has been restored. '
      displayTime: 5
    - text: 'The Picasso is no longer at risk of imminent destruction. '
      displayTime: 4
    - text: 'I have begun broadcasting an SOS, and predict a rescue crew will arrive
        soon. We are safe. '
      displayTime: 8
    displayMode: 0
    typingSpeed: 0.05
    targetTextWindow: {fileID: 1406757753}
  - sentences:
    - text: I have just opened the door to your sculpture room.
      displayTime: 3
    - text: 'Studies show artistic expression is an effective emotional processing
        method, '
      displayTime: 3.5
    - text: "and I am acutely aware it is in the field of \u201Cart\u201D that your
        true passions lie. "
      displayTime: 5
    - text: You may now process this near death experience through the medium of
        sculpture.
      displayTime: 5
    - text: 'Everything you will need is within that room. '
      displayTime: 3
    - text: 'I will inform you when the rescue crew arrives. '
      displayTime: 4
    displayMode: 0
    typingSpeed: 0.05
    targetTextWindow: {fileID: 1406757753}
  - sentences:
    - text: 'Captain, the rescue crew is within communications range. '
      displayTime: 4
    - text: 'Whenever you are finished, return to the hallway outside of the maintenance
        room, and I will patch you through. '
      displayTime: 6
    displayMode: 0
    typingSpeed: 0.05
    targetTextWindow: {fileID: 1406757753}
  - sentences:
    - text: 'Warning! The backup fuel cell located in maintenance is experiencing
        a critical meltdown. '
      displayTime: 6
    - text: Captain, there is no time.
      displayTime: 2.5
    - text: 'Retrieve the fuel cell from its casing by the air lock, and bring it
        back to the welding booth for repairs at once. '
      displayTime: 7
    displayMode: 0
    typingSpeed: 0.05
    targetTextWindow: {fileID: 1406757753}
  newsubtitle:
    sentences: []
    displayMode: 0
    typingSpeed: 0.05
    targetTextWindow: {fileID: 0}
  isStart: 0
  isPowerStart: 0
  isTutorialWelded: 0
  isMission1Welded: 0
  glowMat: {fileID: 2100000, guid: 4125c2dfbd6a35b4f867b8fbe484df95, type: 2}
